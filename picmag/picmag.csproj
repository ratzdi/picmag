<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp8.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm;linux-arm64</RuntimeIdentifiers>
    <RootNamespace>picmag</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.5.2</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <PackageReference Include="Mono.Data.Sqlite" Version="1.0.61" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="TurboJpegWrapper" Version="1.5.2" />
  </ItemGroup>
  <ItemGroup>
    <DebDependency Include="libsqlite3-dev" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="completions/picmag.bash-completion" CopyToPublishDirectory="PreserveNewest" LinuxFileMode="0644">
      <LinuxPath>/etc/bash_completion.d/picmag</LinuxPath>
    </Content>
  </ItemGroup>
</Project>
